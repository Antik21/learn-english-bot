# Telegram Bot API token from BotFather.
BOT_TOKEN=replace-me

# Runtime environment: development, staging, production.
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Local development database. The app creates SQLite tables on startup for now.
DATABASE_URL=sqlite+aiosqlite:///./data/app.sqlite3

# Amplitude analytics is planned. Keep disabled until analytics client is implemented.
AMPLITUDE_ENABLED=false
AMPLITUDE_API_KEY=
